# Copy this file to .env and adjust as needed.

# Leave unset for local dev — falls back to an insecure dev key.
# MUST be set to a real secret in production (DEBUG=False will refuse to start without it).
SECRET_KEY=

DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset for local dev — falls back to a local SQLite file (backend/db.sqlite3).
# In production, point this at your hosted Postgres instance, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/pridal_db
DATABASE_URL=

# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://chandraskn.github.io
